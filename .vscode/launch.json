{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Attach auth-service (9229)",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/apps/auth-service/**/*.js"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach notification-service (9230)",
      "port": 9230,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/apps/notification-service/**/*.js"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach trip-service (9231)",
      "port": 9231,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/apps/trip-service/**/*.js"]
    }
  ],
  "compounds": [
    {
      "name": "Attach all services",
      "configurations": [
        "Attach auth-service (9229)",
        "Attach notification-service (9230)",
        "Attach trip-service (9231)"
      ]
    }
  ]
}
