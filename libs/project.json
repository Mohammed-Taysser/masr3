{
  "name": "libs",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project libs --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "command": "tsc --noEmit -p {projectRoot}/tsconfig.lib.json && tsc --noEmit -p {projectRoot}/tsconfig.spec.json"
      }
    }
  }
}
