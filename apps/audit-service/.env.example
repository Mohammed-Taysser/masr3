
# --- App
NODE_ENV=development
PORT=7000
SERVICE_NAME=audit-service

# --- Database-----
# pgbouncer's host-published port. This service always runs on the host with
# `nx serve`, never in docker, so it reaches pgbouncer over localhost — not the
# docker-internal `masr3-pgbouncer:6432`
DATABASE_HOST=localhost
DATABASE_PORT=41500

# --- Messaging
KAFKA_BROKER=localhost:42000
KAFKA_CLIENT_ID=audit-service

# --- Auth
# auth-service base URL, including the /api prefix. Access tokens are verified
# locally against its JWKS at <AUTH_SERVICE_URL>/.well-known/jwks.json.
AUTH_SERVICE_URL=http://localhost:7000/api
