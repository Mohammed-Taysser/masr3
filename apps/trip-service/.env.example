
# --- App
NODE_ENV=development
PORT=7002
SERVICE_NAME=trip-service

# --- Database-----
# pgbouncer's host-published port. This service always runs on the host with
# `nx serve`, never in docker, so it reaches pgbouncer over localhost — not the
# docker-internal `masr3-pgbouncer:6432`. pgbouncer fronts every service's
# database on this one port; POSTGRES_DB in db.env picks which.
DATABASE_HOST=localhost
DATABASE_PORT=41500

# --- Trips
# How long a REQUESTED trip stays open for offers before it expires.
TRIP_REQUEST_TTL_MS=600000

# --- Auth
# auth-service base URL, including the /api prefix. Access tokens are verified
# locally against its JWKS at <AUTH_SERVICE_URL>/.well-known/jwks.json.
AUTH_SERVICE_URL=http://localhost:7000/api
