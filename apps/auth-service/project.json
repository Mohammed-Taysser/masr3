{
  "name": "auth-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/auth-service/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/auth-service/package.json",
        "{workspaceRoot}/dist/apps/auth-service/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/auth-service/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "auth-service:build",
        "runBuildTargetDependencies": false,
        "port": 9229
      },
      "configurations": {
        "development": {
          "buildTarget": "auth-service:build:development"
        },
        "production": {
          "buildTarget": "auth-service:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TS_NODE_PROJECT=apps/auth-service/tsconfig.app.json TS_NODE_BASEURL=\"$PWD\" NODE_OPTIONS=\"-r tsconfig-paths/register\" typeorm-ts-node-commonjs migration:run -d apps/auth-service/src/database/data-source.ts"
      }
    },
    "migrate-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if [ -z \"{args.name}\" ]; then echo 'Error: migration name is required. Usage: nx run auth-service:migrate-generate --name=CreateUsers'; exit 1; fi; TS_NODE_PROJECT=apps/auth-service/tsconfig.app.json TS_NODE_BASEURL=\"$PWD\" NODE_OPTIONS=\"-r tsconfig-paths/register\" typeorm-ts-node-commonjs migration:generate apps/auth-service/src/database/migrations/{args.name} -d apps/auth-service/src/database/data-source.ts"
      }
    },
    "migrate-revert": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TS_NODE_PROJECT=apps/auth-service/tsconfig.app.json TS_NODE_BASEURL=\"$PWD\" NODE_OPTIONS=\"-r tsconfig-paths/register\" typeorm-ts-node-commonjs migration:revert -d apps/auth-service/src/database/data-source.ts"
      }
    },
    "migration-show": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TS_NODE_PROJECT=apps/auth-service/tsconfig.app.json TS_NODE_BASEURL=\"$PWD\" NODE_OPTIONS=\"-r tsconfig-paths/register\" typeorm-ts-node-commonjs migration:show -d apps/auth-service/src/database/data-source.ts"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "dependsOn": ["migrate"],
      "outputStyle": "static",
      "options": {
        "command": "TS_NODE_PROJECT=apps/auth-service/tsconfig.app.json TS_NODE_BASEURL=\"$PWD\" ts-node -r tsconfig-paths/register apps/auth-service/src/database/seeds/seed-users.ts"
      }
    },
    "generate-signing-key": {
      "executor": "nx:run-commands",
      "outputStyle": "static",
      "options": {
        "command": "TS_NODE_PROJECT=apps/auth-service/tsconfig.app.json TS_NODE_BASEURL=\"$PWD\" ts-node -r tsconfig-paths/register apps/auth-service/src/modules/signing-key/generate-signing-key.ts"
      }
    },
    "kafka:create-topics": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/kafka-create-topics.sh",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "command": "tsc --noEmit -p {projectRoot}/tsconfig.app.json && tsc --noEmit -p {projectRoot}/tsconfig.spec.json"
      }
    }
  }
}
