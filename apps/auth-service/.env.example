
# --- App
NODE_ENV=development
PORT=7000
SERVICE_NAME=auth-service

# --- Auth
# RS256 signing key, relative to the workspace root. Create it with
# `npx nx run auth-service:generate-signing-key --name=jwt`. Every other service
# verifies tokens against the public half, published at /api/.well-known/jwks.json.
JWT_PRIVATE_KEY_FILE=apps/auth-service/secrets/jwt.private.pem
# Only during a key rotation: the old key's .public.pem, kept for
# REFRESH_TOKEN_EXPIRES_IN_SECONDS so tokens it signed keep verifying.
# JWT_PREVIOUS_PUBLIC_KEY_FILE=apps/auth-service/secrets/jwt-old.public.pem

# Downstream services accept an access token until it expires, even after
# logout: this is the revocation window.
ACCESS_TOKEN_EXPIRES_IN_SECONDS=300
# Fixed, never extended by a refresh. Changing it changes the session policy.
REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800
SERVICE_TOKEN_EXPIRES_IN_SECONDS=300

# --- Service clients
# One secret per calling service, from `openssl rand -hex 32`. The same value
# goes in that service's SERVICE_CLIENT_SECRET.
NOTIFICATION_SERVICE_CLIENT_SECRET=

# How long a password-reset email's link stays usable.
PASSWORD_RESET_TOKEN_TTL_MS=600000

# --- Rate limiting
# short/medium/long apply globally; sensitive endpoints (login, register,
# forgot-password) override with a tighter limit of their own.
THROTTLE_SHORT_TTL_MS=1000
THROTTLE_SHORT_LIMIT=3
THROTTLE_MEDIUM_TTL_MS=10000
THROTTLE_MEDIUM_LIMIT=20
THROTTLE_LONG_TTL_MS=60000
THROTTLE_LONG_LIMIT=100

# --- Database-----
# pgbouncer's host-published port. This service always runs on the host with
# `nx serve`, never in docker, so it reaches pgbouncer over localhost — not the
# docker-internal `masr3-pgbouncer:6432`
DATABASE_HOST=localhost
DATABASE_PORT=41500

# --- Messaging
KAFKA_BROKER=localhost:42000
KAFKA_CLIENT_ID=auth-service
