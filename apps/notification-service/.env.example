
# --- App
NODE_ENV=development
PORT=7001
SERVICE_NAME=notification-service

# Used in email subjects and copy.
APP_NAME=Masr3

# --- Database-----
# pgbouncer's host-published port. This service always runs on the host with
# `nx serve`, never in docker, so it reaches pgbouncer over localhost — not the
# docker-internal `masr3-pgbouncer:6432`. pgbouncer fronts every service's
# database on this one port; POSTGRES_DB in db.env picks which.
DATABASE_HOST=localhost
DATABASE_PORT=41500

# --- Mail
# Points at Mailhog: SMTP on 45000, web UI on http://localhost:45001.
MAIL_HOST=localhost
MAIL_PORT=45000
MAIL_SECURE=false
MAIL_FROM=Masr3 <no-reply@masr3.local>
# MAIL_USER / MAIL_PASSWORD are optional — Mailhog needs neither.

# Where the link in a password-reset email points; the token is appended as
# ?token=...
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password

# --- Messaging
KAFKA_BROKER=localhost:42000
KAFKA_CLIENT_ID=notification-service
# Every replica sharing this id splits the partitions between them. Changing
# it starts a new group, which replays every topic from the beginning.
KAFKA_CONSUMER_GROUP_ID=notification-service

# --- Auth
# auth-service base URL, including the /api prefix.
AUTH_SERVICE_URL=http://localhost:7000/api
# This service's client secret for POST <AUTH_SERVICE_URL>/service-tokens. It
# must equal NOTIFICATION_SERVICE_CLIENT_SECRET in auth-service's .env, and
# SERVICE_NAME must equal its registry id, notification-service.
SERVICE_CLIENT_SECRET=
