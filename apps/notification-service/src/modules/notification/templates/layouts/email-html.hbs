<!--
  The chrome every email shares. Edit this file to restyle all of them at once.

  Table-based with inline styles: the markup Outlook, Gmail and Apple Mail
  agree on. The <style> block only adds mobile padding and a dark palette for
  the clients that support them; every email must read fine without it.

  The content slot (triple braces) is the type's email-html part, already
  escaped. Every other value is escaped here. direction is rtl for Arabic.
-->
<!doctype html>
<html lang="{{locale}}" dir="{{direction}}" xmlns:v="urn:schemas-microsoft-com:vml">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <title>{{title}}</title>
    <style>
      @media (max-width: 600px) {
        .px { padding-left: 20px !important; padding-right: 20px !important; }
        .h1 { font-size: 23px !important; }
      }
      @media (prefers-color-scheme: dark) {
        .bg { background-color: #0F1715 !important; }
        .card { background-color: #17221F !important; border-left-color: #26332F !important; border-right-color: #26332F !important; border-bottom-color: #26332F !important; }
        .notice { color: #F0B44C !important; }
        .link { color: #6FCBB2 !important; }
        .ink { color: #EEF3F1 !important; }
        .body { color: #C3CFCB !important; }
        .muted { color: #8C9B97 !important; }
        .panel { background-color: #1D2A26 !important; border-color: #2B3935 !important; }
        .wordmark { color: #EEF3F1 !important; }
      }
    </style>
  </head>
  <body class="bg" style="margin: 0; padding: 0; background-color: #EDF2F0; -webkit-text-size-adjust: 100%;">
    <div style="display: none; max-height: 0; overflow: hidden; mso-hide: all; font-size: 1px; line-height: 1px; color: #EDF2F0; opacity: 0;">
      {{preheader}}&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;
    </div>

    <table role="presentation" class="bg" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #EDF2F0;">
      <tr>
        <td align="center" style="padding: 32px 12px 40px;">
          <!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; font-family: 'Avenir Next', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
            <tr>
              <td class="px" style="padding: 0 36px 16px;">
                <span class="wordmark" style="font-size: 22px; line-height: 1; font-weight: 800; letter-spacing: -0.5px; color: #0F5C4D;">{{appName}}</span>
              </td>
            </tr>

            <tr>
              <td class="card" style="background-color: #FFFFFF; border: 1px solid #DDE5E2; border-top: 6px solid {{accent}}; border-radius: 12px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td class="px" style="padding: 36px 36px 8px;">
                      {{#if isSecurity}}{{> security-notice}}{{/if}}
                      <h1 class="h1 ink" style="margin: 0 0 20px; font-size: 26px; line-height: 1.25; font-weight: 700; letter-spacing: -0.4px; color: #17201E;">{{title}}</h1>
                      <p class="body" style="margin: 0 0 16px; font-size: 16px; line-height: 1.6; color: #3B4A46;">Hi {{firstName}},</p>
                    </td>
                  </tr>
                  <tr>
                    <td class="px" style="padding: 0 36px 20px;">{{{content}}}</td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td class="px" style="padding: 20px 36px 0;">
                <p class="muted" style="margin: 0 0 6px; font-size: 13px; line-height: 1.6; color: #6B7A76;">{{footer}}</p>
                <p class="muted" style="margin: 0; font-size: 13px; line-height: 1.6; color: #6B7A76;">Sent by {{appName}}. Please don't reply to this email; replies aren't read.</p>
              </td>
            </tr>
          </table>
          <!--[if mso]></td></tr></table><![endif]-->
        </td>
      </tr>
    </table>
  </body>
</html>
