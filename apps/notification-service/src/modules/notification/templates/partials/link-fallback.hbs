<!-- The raw link under a button: {{> link-fallback url=resetUrl}} -->
<table role="presentation" class="panel" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 20px; background-color: #F4F7F6; border: 1px solid #DDE5E2; border-radius: 10px;">
  <tr>
    <td style="padding: 14px 18px;">
      <p class="muted" style="margin: 0 0 6px; font-size: 13px; line-height: 1.5; color: #6B7A76;">Button not working? Paste this link into your browser:</p>
      <a class="link" href="{{url}}" target="_blank" style="font-size: 13px; line-height: 1.5; color: #0F5C4D; word-break: break-all;">{{url}}</a>
    </td>
  </tr>
</table>
