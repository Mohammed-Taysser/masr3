<!-- A boxed list of rows: {{#> panel}}{{> row …}}{{/panel}} -->
<table role="presentation" class="panel" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 4px 0 20px; background-color: #F4F7F6; border: 1px solid #DDE5E2; border-radius: 10px;">
  <tr>
    <td style="padding: 12px 18px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        {{> @partial-block}}
      </table>
    </td>
  </tr>
</table>
