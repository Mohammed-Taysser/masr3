  <td class="muted" valign="top" style="padding: 6px 16px 6px 0; width: 96px; font-size: 14px; line-height: 1.5; color: #6B7A76; white-space: nowrap;">{{label}}</td>
  <td class="ink" valign="top" style="padding: 6px 0; font-size: 14px; line-height: 1.5; color: #17201E; word-break: break-word;">{{value}}</td>
</tr>
