
# --- App
NODE_ENV=development
PORT=7004
SERVICE_NAME=vehicle-service

# --- Database-----
# pgbouncer's host-published port. This service always runs on the host with
# `nx serve`, never in docker, so it reaches pgbouncer over localhost — not the
# docker-internal `masr3-pgbouncer:6432`. pgbouncer fronts every service's
# database on this one port; POSTGRES_DB in db.env picks which.
DATABASE_HOST=localhost
DATABASE_PORT=41500

# --- Queues
# Redis for BullMQ, at its host-published port.
REDIS_HOST=localhost
REDIS_PORT=44000

# --- Kafka
# Host-published broker port. vehicle-service consumes auth.user-changed to keep
# its copy of drivers, and publishes audit events through its outbox.
KAFKA_BROKER=localhost:42000
KAFKA_CLIENT_ID=vehicle-service
KAFKA_CONSUMER_GROUP_ID=vehicle-service

# --- Outbox
# The relay publishes pending outbox rows to Kafka every OUTBOX_POLL_INTERVAL_MS,
# at most OUTBOX_BATCH_SIZE per tick, and deletes published rows older than
# OUTBOX_RETENTION_MS (7 days).
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_RETENTION_MS=604800000

# The relay's pg_try_advisory_xact_lock key. It must be unique to this service:
# a shared lock id would let two services' relays block each other.
OUTBOX_RELAY_LOCK_ID=7004001

# --- Auth
# auth-service base URL, including the /api prefix. Access tokens are verified
# locally against its JWKS at <AUTH_SERVICE_URL>/.well-known/jwks.json.
AUTH_SERVICE_URL=http://localhost:7000/api
