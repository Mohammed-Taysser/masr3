CLUSTER_ID=acFHx4L-QIy3ZWVriMVIxA

KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_LOG_DIRS=/var/lib/kafka/data

# Two data listeners, because a client is told to reconnect to whatever
# address the broker *advertises*, not the one it bootstrapped with:
#   INTERNAL  masr3-kafka:9092  - containers on masr3-network (kafka-ui, healthcheck)
#   EXTERNAL  localhost:42000   - services run on the host with `nx serve`
# docker-compose publishes 42000 -> 9094. Advertising localhost:9092 instead
# would send host clients to whatever else owns host port 9092.
KAFKA_LISTENERS=INTERNAL://:9092,CONTROLLER://:9093,EXTERNAL://:9094
KAFKA_ADVERTISED_LISTENERS=INTERNAL://masr3-kafka:9092,EXTERNAL://localhost:42000

# Plaintext, no auth: dev-only, on a local docker bridge.
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=INTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT,EXTERNAL:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL

KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_CONTROLLER_QUORUM_VOTERS=1@masr3-kafka:9093

# Topics are created explicitly by apps/auth-service/scripts/kafka-create-topics.sh.
# With auto-create on, a typo'd topic name is silently created with the
# broker's defaults instead of failing.
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false

KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
